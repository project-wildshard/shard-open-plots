{
 "about": "Every model a Blender script builds (M10, E315; docs/design/blender-practice.md). The script is the source, the GLB it exports is committed, a .blend never is. Run a target from the repo root with `bash node_modules/@wildshard/sdk/scripts/blender/build.sh <target>`, check one against its committed GLB with `--check`. Fields: script (the Blender entry, run with --python-exit-code 1), args, pre (shell, before Blender), sources (every other file the target needs: the SDK's scripts/check-model-sources.mjs refuses a file under src/blender/ that no target names), inputs (committed files it reads), lock (Cycles work: take the model lock), build (files Blender must leave in $BUILD), meshopt / copy ([build file, repo file] pairs), post (shell, after the copies), outputs (the committed files it makes), feeds (the code that loads them), manual (not buildable here: why), check (the command --check runs for a manual target).",
 "blender": {
  "version": "5.2.1",
  "path": "/opt/homebrew/bin/blender"
 },
 "lock": "~/projects/localai/.model.lock",
 "cache": "~/.cache/wildshard-blender",
 "targets": {
  "open-plots/kit": {
   "about": "The open plots' kit models (Night Market remaster RM4): each family three variants, flat-shaded, ray-traced AO in COLOR_0 (no Cycles: no model lock, byte-stable), data/trim.json's ruled-trim UVs; the plot generator retints them by palette slot",
   "script": "src/blender/open-plots/kit.py",
   "args": [
    "$BUILD"
   ],
   "sources": [
    "src/blender/open-plots/kitlib.py",
    "src/blender/open-plots/model_source.py",
    "scripts/blender/lib/glb.py",
    "src/blender/open-plots/sources/tree-round.glb",
    "src/blender/open-plots/sources/tree-tall.glb"
   ],
   "inputs": [
    "src/shards/open-plots/data/trim.json"
   ],
   "lock": false,
   "build": [
    "lanterns.glb",
    "stalls.glb",
    "houses.glb",
    "bridges.glb",
    "strings.glb",
    "props.glb",
    "canal.glb",
    "trees.glb",
    "figures.glb"
   ],
   "copy": [
    [
     "lanterns.glb",
     "src/shards/open-plots/static/assets/open-plots/kit/lanterns.glb"
    ],
    [
     "stalls.glb",
     "src/shards/open-plots/static/assets/open-plots/kit/stalls.glb"
    ],
    [
     "houses.glb",
     "src/shards/open-plots/static/assets/open-plots/kit/houses.glb"
    ],
    [
     "bridges.glb",
     "src/shards/open-plots/static/assets/open-plots/kit/bridges.glb"
    ],
    [
     "strings.glb",
     "src/shards/open-plots/static/assets/open-plots/kit/strings.glb"
    ],
    [
     "props.glb",
     "src/shards/open-plots/static/assets/open-plots/kit/props.glb"
    ],
    [
     "canal.glb",
     "src/shards/open-plots/static/assets/open-plots/kit/canal.glb"
    ],
    [
     "trees.glb",
     "src/shards/open-plots/static/assets/open-plots/kit/trees.glb"
    ],
    [
     "figures.glb",
     "src/shards/open-plots/static/assets/open-plots/kit/figures.glb"
    ]
